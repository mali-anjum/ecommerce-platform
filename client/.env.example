
# Public browser API origin (no trailing slash, no /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:4001

NEXT_PUBLIC_APP_NAME=Next E-Commerce
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

NODE_ENV=development
DEV_BACKEND_PORT=4001

# Next.js route handlers -> Express backend.
# In development, DEV_URL is preferred; in production, BACKEND_URL is required.
DEV_URL=http://localhost:4001
DEVE_URL=http://localhost:4001
BACKEND_URL=https://ecommerce-platform-841i.onrender.com

# Server-only (middleware / JWT verification) - must match backend values.
JWT_SECRET=
ARCJET_KEY=

# Optional OAuth (client/server usage depends on feature wiring).
GOOGLE_CLIENT_ID=
