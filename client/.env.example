# =============================================================================
# Next.js client — copy to .env.local (development) or set in Vercel (production)
# See docs/ENVIRONMENT.md for loading order and connectivity diagrams.
# =============================================================================

# --- Public (exposed to the browser) -----------------------------------------

# Express API origin — no trailing slash, no /api suffix.
# Local: http://localhost:4001 | Production: https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4001

NEXT_PUBLIC_APP_NAME=Next E-Commerce
NEXT_PUBLIC_APP_ENV=development
# Site origin (payment return URLs, links). Local dev port: 3012
NEXT_PUBLIC_APP_URL=http://localhost:3012
NEXT_PUBLIC_LOG_LEVEL=debug

# PayPal JS SDK — must match server PAYPAL_CLIENT_ID (sandbox or live)
# https://developer.paypal.com/dashboard/applications
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_LOCALE=en_US

# Stripe publishable key — same account as server STRIPE_SECRET_KEY
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry (browser + Next server runtime). Off in dev unless SENTRY_ENABLED=true
# https://sentry.io → Project → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Server-only in Next (never prefixed with NEXT_PUBLIC_) --------------------

NODE_ENV=development

# BFF route handlers (/app/api/*) → Express
# Development: use local API (required for cookies + local DB)
DEV_URL=http://localhost:4001
# Legacy alias (optional; DEV_URL wins if both set)
DEVE_URL=http://localhost:4001
# Production only: public Express origin (Vercel env). Ignored in dev if DEV_URL set.
BACKEND_URL=https://your-api.onrender.com

# Must match server JWT_SECRET — used by src/proxy.ts to verify access cookies
# Generate: openssl rand -base64 32
JWT_SECRET=

# Arcjet rate limiting — https://app.arcjet.com
ARCJET_KEY=

# Sentry build/upload (optional, CI/Vercel)
# SENTRY_RELEASE=git-sha-or-deploy-id
# SENTRY_ENABLED=true
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_DSN=  # fallback if NEXT_PUBLIC_SENTRY_DSN unset

# --- Optional OAuth (client route handlers / UI) ------------------------------

GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_BRIDGE_SECRET=  # must match server if bridge is enabled

# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
