# Public browser API origin (no trailing slash, no /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:4001

NEXT_PUBLIC_APP_NAME=Next E-Commerce
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3012
NEXT_PUBLIC_LOG_LEVEL=debug

# PayPal JS SDK (public client id — match server PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_LOCALE=en_US

# Stripe publishable key (match server account; required for client Stripe helpers)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NODE_ENV=development
DEV_BACKEND_PORT=4001

# Next.js route handlers → Express backend
DEV_URL=http://localhost:4001
DEVE_URL=http://localhost:4001
BACKEND_URL=https://your-api.onrender.com

# Server-only (middleware) — must match server JWT_SECRET
JWT_SECRET=
ARCJET_KEY=

# Optional OAuth
GOOGLE_CLIENT_ID=
