# Public browser API origin (no trailing slash, no /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:4001

NEXT_PUBLIC_APP_NAME=Next E-Commerce
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3012
NEXT_PUBLIC_LOG_LEVEL=debug

# PayPal JS SDK (public client id — match server PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_LOCALE=en_US

# Stripe publishable key (match server account; required for client Stripe helpers)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry (browser + Next server; off in local dev unless SENTRY_ENABLED=true)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=git-sha-or-deploy-id
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENABLED=true
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

NODE_ENV=development
DEV_BACKEND_PORT=4001

# Next.js route handlers → Express backend
DEV_URL=http://localhost:4001
DEVE_URL=http://localhost:4001
BACKEND_URL=https://your-api.onrender.com

# Server-only (middleware) — must match server JWT_SECRET
JWT_SECRET=
ARCJET_KEY=

# Optional OAuth
GOOGLE_CLIENT_ID=

# OAuth bridge (must match server OAUTH_BRIDGE_SECRET)
OAUTH_BRIDGE_SECRET=

# Google OAuth
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Entra ID OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM private key; use \n for newlines in .env
APPLE_PRIVATE_KEY=
