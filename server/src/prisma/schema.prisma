generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) 
  name         String?
  email        String    @unique
  password     String
  role         Role      @default(USER)
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  refreshToken String?   @unique
  addresses    Address[]
  cart         Cart?
  orders       Order[]
  userCoupons  UserCoupon[]
}

model Department {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  description    String?
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subcategories  Subcategory[]
}

model Subcategory {
  id           String      @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  products     Product[]

  @@unique([departmentId, slug])
  @@index([departmentId])
}

model Product {
  id             String       @id @default(uuid())
  name           String
  brand          String
  description    String
  category       String
  gender         String
  sizes          String[]
  colors         String[]
  price          Float       // Use Float instead of Decimal
  stock          Int         @default(0)
  soldCount      Int         @default(0)
  rating         Float?      // Use Float instead of Decimal
  images         String[]
  isActive       Boolean     @default(true)
  isArchived     Boolean     @default(false)
  isFeatured     Boolean     @default(false)
  subcategoryId  String?
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([subcategoryId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  size      String?
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, size, color])
  @@index([productId])
  @@index([cartId, productId])
}

model FeatureBanner {
  id        String   @id @default(uuid())
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id              String     @id @default(uuid())
  code            String     @unique
  discountPercent Float      // Percentage (0-100)
  startDate       DateTime
  endDate         DateTime
  usageLimit      Int
  usageCount      Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  isActive        Boolean    @default(true)
  maxDiscount     Float?     // Maximum discount amount
  minOrderValue   Float?     // Minimum order value required
  orders          Order[]
  userCoupons     UserCoupon[]  // ✅ Many-to-many relation with users

  @@index([code])
  @@index([isActive])
}

model UserCoupon {
  id        String   @id @default(uuid())
  userId    String
  couponId  String
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
  @@index([userId])
  @@index([couponId])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  name       String
  address    String
  city       String
  country    String
  postalCode String
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId])
  @@index([isDefault])
}

model Order {
  id                String        @id @default(uuid())
  userId            String
  addressId         String
  couponId          String?
  total             Float         // Use Float
  currency          String        @default("USD")
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  paymentId         String?       // Internal payment reference
  providerOrderId   String?       // PayPal/Stripe order ID
  providerCaptureId String?       // Actual capture/charge ID from provider
  capturedAt        DateTime?     // When payment was captured
  notes             String?       // For admin notes, cancellation reasons, etc.
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  address           Address       @relation(fields: [addressId], references: [id], onDelete: Cascade)
  coupon            Coupon?       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]

  @@index([userId])
  @@index([addressId])
  @@index([couponId])
  @@index([paymentId])
  @@index([providerOrderId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String?
  productName     String
  productCategory String
  quantity        Int
  size            String?
  color           String?
  price           Float    // Use Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

enum Role {
  USER
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING            // Alias for DRAFT (for backward compatibility)
  DRAFT              // Order created but payment not initiated
  PENDING_PAYMENT    // Payment initiated, waiting for user approval
  PAYMENT_APPROVED   // User approved payment, ready for capture
  PROCESSING         // Payment captured, order being processed
  SHIPPED            // Order shipped to customer
  DELIVERED          // Order delivered
  CANCELLED          // Order cancelled (before shipping)
  PAYMENT_FAILED     // Payment failed
  CAPTURE_FAILED     // Payment capture failed
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAL
  STRIPE
}

// UPDATED PaymentStatus enum
enum PaymentStatus {
  PENDING     // Payment initiated but not completed
  APPROVED    // User approved payment (PayPal specific)
  COMPLETED   // Payment successfully captured
  FAILED      // Payment failed
  REFUNDED    // Payment refunded
  CANCELLED   // Payment cancelled by user
}