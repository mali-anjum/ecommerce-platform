generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  name          String?
  email         String         @unique
  password      String?
  image         String?
  role          Role           @default(USER)
  emailVerified Boolean        @default(false)
  profileComplete Boolean      @default(true)
  isActive      Boolean        @default(true)
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshToken  String?        @unique
  addresses     Address[]
  cart          Cart?
  wishlist      Wishlist?
  orders        Order[]
  userCoupons   UserCoupon[]
  seller        Seller?
  oauthAccounts OAuthAccount[]
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
  GITHUB
  MICROSOFT
}

model Department {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  description    String?
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subcategories  Subcategory[]
}

model Subcategory {
  id           String      @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  products     Product[]

  @@unique([departmentId, slug])
  @@index([departmentId])
}

model Seller {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  isPremium Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  orderItems OrderItem[]
  shipments OrderShipment[]

  @@index([isPremium, isActive])
}

model Product {
  id             String       @id @default(uuid())
  name           String
  brand          String
  condition      ProductCondition @default(NEW)
  description    String
  category       String
  gender         String
  sizes          String[]
  colors         String[]
  price          Float       // Use Float instead of Decimal
  discountPercent Float?
  dealStartsAt    DateTime?
  dealEndsAt      DateTime?
  stock          Int         @default(0)
  soldCount      Int         @default(0)
  rating         Float?      // Use Float instead of Decimal
  images         String[]
  isActive       Boolean     @default(true)
  isArchived     Boolean     @default(false)
  isFeatured     Boolean     @default(false)
  sellerId       String?
  seller         Seller?     @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  subcategoryId  String?
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]

  @@index([subcategoryId])
  @@index([sellerId])
  @@index([condition])
  @@index([discountPercent])
  @@index([dealStartsAt, dealEndsAt])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  size      String?
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, size, color])
  @@index([productId])
  @@index([cartId, productId])
}

/// One wishlist per user (Amazon-style saved list). Items reference live product rows for price/stock sync.
model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@index([updatedAt])
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
  @@index([wishlistId, createdAt])
}

model FeatureBanner {
  id        String   @id @default(uuid())
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id              String     @id @default(uuid())
  code            String     @unique
  discountPercent Float      // Percentage (0-100)
  startDate       DateTime
  endDate         DateTime
  usageLimit      Int
  usageCount      Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  isActive        Boolean    @default(true)
  maxDiscount     Float?     // Maximum discount amount
  minOrderValue   Float?     // Minimum order value required
  orders          Order[]
  userCoupons     UserCoupon[]  // ✅ Many-to-many relation with users

  @@index([code])
  @@index([isActive])
}

model UserCoupon {
  id        String   @id @default(uuid())
  userId    String
  couponId  String
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
  @@index([userId])
  @@index([couponId])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  name       String
  address    String
  city       String
  country    String
  postalCode String
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId])
  @@index([isDefault])
}

model Order {
  id            String        @id @default(uuid())
  userId        String
  addressId     String
  couponId      String?
  total         Float         // Use Float
  currency      String        @default("USD")
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  notes         String?       // For admin notes, cancellation reasons, etc.
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  address       Address       @relation(fields: [addressId], references: [id], onDelete: Cascade)
  coupon        Coupon?       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  payments      Payment[]
  trackingEvents OrderTrackingEvent[]
  shipments     OrderShipment[]

  @@index([userId])
  @@index([addressId])
  @@index([couponId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderShipment {
  id                 String   @id @default(uuid())
  orderId            String
  key                String   @default("DEFAULT") // stable identifier per order (DEFAULT or seller-specific)
  sellerId           String?
  carrier            String?
  trackingNumber     String?
  estimatedDeliveryAt DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller             Seller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  trackingEvents     OrderTrackingEvent[]

  @@index([orderId])
  @@index([sellerId])
  @@unique([orderId, key])
}

model OrderTrackingEvent {
  id          String   @id @default(uuid())
  orderId     String
  shipmentId  String?
  status      OrderStatus?
  message     String
  location    String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment    OrderShipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
  @@index([shipmentId, occurredAt])
  @@index([occurredAt])
}

/// One row per payment attempt / provider session (PayPal order, Stripe Checkout session, etc.).
model Payment {
  id                  String               @id @default(uuid())
  orderId             String
  method              PaymentMethod
  attemptStatus       PaymentAttemptStatus @default(PENDING)
  /// Provider primary reference: PayPal Order ID, Stripe Checkout Session ID, etc.
  providerReferenceId String?
  providerCaptureId   String?
  approvalUrl         String?
  checkoutUrl         String?
  clientSecret        String?
  amount              Float?
  currency            String               @default("USD")
  capturedAt          DateTime?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerReferenceId])
  @@index([attemptStatus])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String?
  sellerId        String?
  seller          Seller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  productName     String
  productCategory String
  quantity        Int
  size            String?
  color           String?
  price           Float    // Use Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

enum Role {
  USER
  SELLER
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING            // Alias for DRAFT (for backward compatibility)
  DRAFT              // Order created but payment not initiated
  PENDING_PAYMENT    // Payment initiated, waiting for user approval
  PAYMENT_APPROVED   // User approved payment, ready for capture
  PROCESSING         // Payment captured, order being processed
  SHIPPED            // Order shipped to customer
  DELIVERED          // Order delivered
  CANCELLED          // Order cancelled (before shipping)
  PAYMENT_FAILED     // Payment failed
  CAPTURE_FAILED     // Payment capture failed
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAL
  STRIPE
}

/// Lifecycle of a single payment attempt (distinct from order-level PaymentStatus summary).
enum PaymentAttemptStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  CANCELLED
}

// UPDATED PaymentStatus enum
enum PaymentStatus {
  PENDING     // Payment initiated but not completed
  APPROVED    // User approved payment (PayPal specific)
  COMPLETED   // Payment successfully captured
  FAILED      // Payment failed
  REFUNDED    // Payment refunded
  CANCELLED   // Payment cancelled by user
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

/// Admin-editable FAQ entries for help center and AI assistant context.
model FaqItem {
  id        String   @id @default(uuid())
  question  String
  answer    String
  href      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Singleton store policies (shipping, returns) for storefront and AI assistant.
model StorePolicySettings {
  id                           String   @id @default("default")
  returnPolicy                 String   @default("")
  shippingPolicy               String   @default("")
  shipsInternationally         Boolean  @default(false)
  internationalShippingDetails String   @default("")
  supportEmail                 String?
  updatedAt                    DateTime @updatedAt
}

enum LeadSource {
  AI
  MANUAL
}

enum KnowledgeSourceType {
  PDF
  MANUAL
}

enum AnalyticsEventType {
  CHAT
  PRODUCT_VIEW
  CART_ADD
  ORDER_COMPLETE
}

/// Funnel and behavioral event log for analytics.
model AnalyticsEvent {
  id        String             @id @default(uuid())
  type      AnalyticsEventType
  userId    String?
  sessionId String?
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Server-side AI chat session memory (DB fallback when Redis is unavailable).
model AiChatSession {
  id           String   @id
  userId       String?
  messages     Json     @default("[]")
  failureCount Int      @default(0)
  openTicketId String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([userId, updatedAt])
  @@index([openTicketId])
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

/// Human support escalation ticket from the AI assistant.
model SupportTicket {
  id        String              @id @default(uuid())
  userId    String?
  sessionId String?
  status    SupportTicketStatus @default(OPEN)
  messages  Json                @default("[]")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId, status])
  @@index([sessionId, status])
  @@index([status, updatedAt])
}

/// AI assistant conversation log for analytics and conversion tracking.
model AiConversationLog {
  id               String   @id @default(uuid())
  userId           String?
  query            String
  intent           String
  convertedToOrder Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([intent, createdAt])
  @@index([convertedToOrder, createdAt])
  @@index([createdAt])
}

/// Admin-uploaded documents and manual entries for AI assistant context.
model KnowledgeBase {
  id         String               @id @default(uuid())
  title      String
  content    String               @db.Text
  sourceType KnowledgeSourceType
  fileUrl    String?
  fileName   String?
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([isActive, createdAt])
  @@index([sourceType])
}

/// Denormalized product search payloads for the AI assistant (survives process restarts).
model AiProductSearchIndex {
  productId String   @id
  payload   Json
  updatedAt DateTime @updatedAt

  @@map("ai_product_search_index")
}

model AiProductSearchIndexMeta {
  id           String    @id @default("default")
  lastSyncedAt DateTime?
  entryCount   Int       @default(0)

  @@map("ai_product_search_index_meta")
}

/// Sales / CRM lead captured from AI assistant or manual admin entry.
model Lead {
  id        String     @id @default(uuid())
  email     String
  phone     String?
  message   String
  source    LeadSource @default(AI)
  createdAt DateTime   @default(now())

  @@index([source, createdAt])
  @@index([email])
  @@index([createdAt])
}