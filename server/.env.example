DATABASE_URL="postgresql://user:password@localhost:5436/nextecommerce?schema=public"
# Only set in production (e.g. .yourdomain.com). Leave unset in local dev so cookies work on :3012 via the Next.js proxy.
# COOKIE_DOMAIN=

PORT=4001
NODE_ENV=development

# Postgres (Docker maps 5432 -> local 5436 in your compose)

JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=



# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# BCP-47 (e.g. en-US, ar-SA). Used in payment_source.paypal.experience_context.
PAYPAL_LOCALE=en-US
# Must match your Next.js app origin and routes /paypal/return, /paypal/cancel.
PAYPAL_RETURN_URL=http://localhost:3012/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3012/paypal/cancel

# Stripe Checkout (card payments) — STRIPE_SECRET_KEY is required for checkout to appear
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Next.js origin for redirects (local dev: http://localhost:3012)
STRIPE_CHECKOUT_BASE_URL=http://localhost:3012
# Optional overrides (defaults: {STRIPE_CHECKOUT_BASE_URL}/stripe/return|cancel)
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Email (nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Google OAuth (Arctic on Express)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Facebook OAuth (optional — wire routes when ready)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Microsoft Entra ID OAuth (optional)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Apple Sign In (optional — requires PKCS8 private key)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Next.js app origin (post-login redirects + OAuth cookie handoff)
FRONTEND_URL=http://localhost:3012
# Public backend URL when behind a proxy (optional in local dev)
BACKEND_PUBLIC_URL=http://localhost:4001

# OpenAI shopping assistant (AI-001)
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini
OPENAI_MODEL=

# Optional: custom path to feature-flags.config.json (not required).
# Production uses server/feature-flags.config.json (copied from client at build).
# FEATURE_FLAGS_CONFIG_PATH=/absolute/path/to/feature-flags.config.json