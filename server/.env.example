# =============================================================================
# Express API — copy to .env.local (development) or host dashboard (production)
# Loaded by server/src/config/loadEnv.ts — see docs/ENVIRONMENT.md
# =============================================================================

# --- Core (required) -----------------------------------------------------------

# Local Docker (server/docker-compose.yml): port 5436 on host
DATABASE_URL="postgresql://user:password@localhost:5436/nextecommerce?schema=public"
# Production: Neon/Supabase connection string with ?sslmode=require

PORT=4001
NODE_ENV=development

# Must match client JWT_SECRET (proxy.ts + API tokens)
JWT_SECRET=

# Next.js storefront origin — CORS + payment/OAuth redirects
FRONTEND_URL=http://localhost:3012

# Public API URL when behind proxy (OAuth callback defaults). Local: optional
BACKEND_PUBLIC_URL=http://localhost:4001

# Production only: cookie domain on API host (e.g. .your-api.onrender.com)
# LEAVE UNSET in local dev so cookies work via Next on localhost:3012
# COOKIE_DOMAIN=

# --- Cloudinary (required for image uploads) ---------------------------------
# https://console.cloudinary.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Legacy token env (optional; runtime uses JWT_SECRET) ----------------------

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# --- Stripe (optional — enables card checkout when set) ----------------------
# https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CHECKOUT_BASE_URL=http://localhost:3012
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# --- PayPal (optional) ---------------------------------------------------------
# https://developer.paypal.com/dashboard/applications

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_LOCALE=en-US
PAYPAL_RETURN_URL=http://localhost:3012/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3012/paypal/cancel
APP_NAME=Ecommerce Store

# --- Email (optional) --------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@localhost

# --- Google OAuth (optional) ---------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Facebook OAuth (optional) -----------------------------------------------

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# --- GitHub OAuth (optional) -------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# --- Microsoft Entra ID (optional) ---------------------------------------------

MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# --- Apple Sign In (optional) ------------------------------------------------

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# APPLE_PRIVATE_KEY_PATH=

# --- AI LLM providers (optional) ---------------------------------------------
# Active vendor: feature-flags.config.json → ai.llmProvider (openai | gemini | llama)
# Set keys for the provider you choose. Restart server after changing config.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Llama via Ollama (OpenAI-compatible API) — https://ollama.com
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_MODEL=llama3.2
# LLAMA_API_KEY=ollama

# --- Sentry (optional) ---------------------------------------------------------
# Separate Sentry project recommended for API vs Next web

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=git-sha-or-deploy-id
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENABLED=true

# --- Logging (optional) --------------------------------------------------------

LOG_ENABLED=true
LOG_LEVEL=info

# --- Prisma pool (optional) ----------------------------------------------------

# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=20000

# --- Feature flags (optional) --------------------------------------------------

# FEATURE_FLAGS_CONFIG_PATH=/absolute/path/to/feature-flags.config.json

# --- Example card gateway stub (optional) --------------------------------------

# CARD_PAYMENT_API_KEY=
# CARD_PAYMENT_BASE_URL=
