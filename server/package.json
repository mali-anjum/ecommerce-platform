{
  "name": "server",
  "version": "1.0.0",
  "description": "Ecommerce backend using Express, Prisma, and TypeScript",
  "main": "src/server.ts",
  "scripts": {
    "dev": "npm run sync:feature-flags && tsx watch src/server.ts",
    "dev:ts": "tsx watch src/server.ts",
    "sync:feature-flags": "sh -c 'test -f ../client/feature-flags.config.json && cp ../client/feature-flags.config.json ./feature-flags.config.json || test -f ./feature-flags.config.json'",
    "build": "npm run sync:feature-flags && npx prisma generate --schema=src/prisma/schema.prisma && tsc --skipLibCheck",
    "start": "node dist/server.js",
    "prisma:generate": "npx prisma generate --schema=src/prisma/schema.prisma",
    "prisma:migrate:dev": "npx prisma migrate dev --schema=src/prisma/schema.prisma",
    "prisma:migrate:deploy": "npx prisma migrate deploy --schema=src/prisma/schema.prisma",
    "prisma:migrate:reset": "npx prisma migrate reset --schema=src/prisma/schema.prisma",
    "prisma:seed": "ts-node src/prisma/seed.ts",
    "render-build": "npm ci --include=dev && npx prisma generate --schema=src/prisma/schema.prisma && npm run build && npx prisma migrate deploy --schema=src/prisma/schema.prisma",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node src/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@sentry/node": "^9.47.1",
    "arctic": "^3.7.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "openai": "^6.39.1",
    "pdf-parse": "^1.1.4",
    "pg": "^8.17.2",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "stripe": "^20.0.0",
    "uuid": "^11.0.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash": "^4.17.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.10.9",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/pino": "^7.0.4",
    "@types/stripe": "^8.0.416",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^7.3.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
